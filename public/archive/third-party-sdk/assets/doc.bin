                                            name="back_problem">内容找不到</label>
                                    <label class="rdo"><input type="checkbox" value="1"
                                            name="back_problem">内容不准确</label>
                                    <label class="rdo"><input type="checkbox" value="2"
                                            name="back_problem">内容描述不清楚</label>
                                    <label class="rdo"><input type="checkbox" value="3"
                                            name="back_problem">内容没更新</label>
                                    <label class="rdo"><input type="checkbox" value="4"
                                            name="back_problem">文档结构混乱</label>
