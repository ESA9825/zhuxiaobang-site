<div class="modal" tabindex="-1" role="dialog" id="save-the-draft">
    <div class="modal-dialog" role="document" style="margin: -120px 0 0 -210px;width: 470px;">
        <div class="modal-content">
            <div class="modal-header">
                <p>提示</p>
                <button type="button" class="close no" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div style="font-size: 18px">检测到已保存草稿内容，是否加载草稿？</div>
                <div style="margin-bottom: 10px">
                    <button class="btn yes">是</button>
                    <button class="btn no">否</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal message" id="draft-success" tabindex="-1" role="dialog" aria-labelledby="publicSuccessModalLabel" data-backdrop="false">
  <div class="modal-dialog" role="document" style="margin: -120px 0 0 -250px !important">
    <div class="modal-content" style="height: 100px;">
      <div class="modal-header" style="padding: 18px 0;">
        <h4 class="modal-title" style="font-size: 18px">
            <img src="/static/images/os-icon-success-solid.png" width="24" height="24" alt="">
            <span>保存草稿成功</span>
        </h4>
      </div>
      <div class="modal-body" style="text-align: center;top: -24px;padding: 0;">
        <p>注意：当应用进行版本升级后，会清空草稿箱内容</p>
      </div>
    </div>
  </div>
</div>
<!-- 是否保存草稿 end -->

<!-- loading -->
<style>
.loading-shadow{
    position: fixed;
    z-index: 999991;
    top: 0;
    left: 0;
    display: none;
    width: 100%;
    height: 100%;
}
.loading-shadow:after{
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    content: "";
    background-color: #000;
    opacity: 0.3;
}
.loading-shadow img{
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    margin: -60px 0 0 -60px;
}
.loading-rotate {
	animation: loading-rotate 1s infinite linear;
	-webkit-animation: loading-rotate 1s infinite linear;
}
.checking{
    color: #49c9a2;
    position: absolute;
    top: 50%;
    left: 46.4%;

}
.loading-text{
    position: absolute;
    z-index: 999999;
    top: 50%;
    left: 50%;
    margin: -12px 0 0 -70px;
    color:#49c9a2;
}
@keyframes loading-rotate {
	0% {
		transform: rotate(0deg);
		-webkit-transform: rotate(0deg);
	}
	100% {
		transform: rotate(360deg);
		-webkit-transform: rotate(360deg);
	}
}

-webkit-@keyframes loading-rotate  {
	0% {
		transform: rotate(0deg);
		-webkit-transform: rotate(0deg);
	}
	100% {
		transform: rotate(360deg);
		-webkit-transform: rotate(360deg);
	}
}

</style>
<div class="loading-shadow">
    <img width="40" height="40" class="loading-rotate" src="/static/images/loading2.png" onerror="this.onerror=null; this.src='/static/images/loading'">
    <p style="display: none" class="loading-text dsn">上传中...</p>
</div>
