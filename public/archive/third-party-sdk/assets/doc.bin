<style>
	#teamProtocolModal .modal-dialog {
		margin: 0 0 0 -450px;
		top: 32px;
		width: 900px;
	}
	#teamProtocolModal .modal-body {
		margin: 0 15px;
		padding: 15px;
		height: 400px;
		overflow-y: auto;
		border: 1px solid #e8e8e8;
	}
	#teamProtocolModal .modal-team-protocol-content h4 {
		margin: 10px 0;
		padding: 0;
		height: auto;
		background: none;
		border: none;
		font-size: 18px;
		line-height: 1.1;
		color: #4a4949;
	}
	#teamProtocolModal .modal-team-protocol-content p {
		margin: 10px 0;
		color: #7b7b7b;
	}
	#teamProtocolModal .btn-primary {
		margin: 0 30px;
		width: 120px;
		background-color: #49c9a2;
		border-color: #49c9a2;
		border-radius: 6px;
		font-size: 16px;
		color: #fff;
		outline-color: #49c9a2;
		outline: none;
	}
	#teamProtocolModal .btn-default {
		margin: 0 30px;
		width: 120px;
		background-color: #adadad;
		border-color: #adadad;
		border-radius: 6px;
		font-size: 16px;
		color: #fff;
		outline-color: #adadad;
		outline: none;
	}
	#teamProtocolModal .btn-primary:hover,
	#teamProtocolModal .btn-primary:focus {
		background-color: #49c9a2;
		border-color: #49c9a2;
	}
