<!-- 登录弹窗 -->
<div class="modal modal-mid fade" id="signInModal" tabindex="-1" role="dialog" aria-labelledby="signInModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="signInModalLabel">账号登录</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="form-horizontal login validation" action="/user/signin" noredirect="true" needReload="true" showErrMsgHere="true" onSuccessDealer="onLoginRespone" needCaptcha="true">
                    <fieldset>
                        <div class="alert alert-warning"></div>
                        <!-- 账号 input-->
                        <div class="form-group">
                            <label class="col-xs-2 col-sm-2 col-lg-2 control-label" for="textinput">用户名</label>
                            <div class="col-xs-8 col-sm-8 col-lg-8">
                                <input name="userName" type="text" maxlength="32" placeholder="" class="form-control" required data-event="change-msg">
                                <span class="help-block">用户名 / 邮箱</span><span class="error-tip">用户名只能包含数字、字母、汉字，不能是纯数字。长度在2至12之间。邮箱长度在32以内。</span>
                            </div>
                        </div>
                        <!-- 密码 input-->
                        <div class="form-group">
                            <label class="col-xs-2 col-sm-2 col-lg-2 control-label" for="passwordinput">密码</label>
                            <div class="col-xs-8 col-sm-8 col-lg-8">
                                <input name="password" type="password" placeholder="" class="form-control" required data-event="change-msg">
                                <span class="error-tip">密码不能为空。</span>
                            </div>
                        </div>
                        <!-- 验证码 input-->
                        <div class="form-group special">
                            <label class="col-xs-2 col-sm-2 col-lg-2 control-label" for="textinput">验证码</label>
                            <div class="col-xs-8 col-sm-8 col-lg-8">
                                <div class="row">
                                    <div class="col-xs-3 col-sm-3 col-md-5">
                                        <input name="verifyCode" type="text" placeholder="" class="form-control" required>
                                        <span class="error-tip">请输入验证码。</span>
                                    </div>
                                    <div class="col-xs-9 col-sm-9 col-md-7 captcha-wrap">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- 按钮-->
                        <div class="form-group btn-wrap">
                            <div class="col-xs-8 col-sm-8 col-lg-8 col-xs-offset-2 col-sm-offset-2 col-md-offset-2">
                                <button type="submit" name="singlebutton" class="btn btn-primary col-md-12 col-sm-12 col-xs-12">立即登录
                                </button>
                            </div>
                        </div>
                        <!-- 注册新账号 忘记密码-->
                        <div class="form-group special2">
                            <div class="col-xs-8 col-sm-8 col-lg-8 col-xs-offset-2 col-sm-offset-2 col-md-offset-2 text-center">
                                <a href="javascript:void(0);" class="switch-modal" data-it="signInModal" data-id="signUpModal">注册新账号</a>
                                <a href="javascript:void(0);" class="switch-modal" data-it="signInModal" data-id="retrieveModal">忘记密码</a>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- 登录弹窗 -->
<!-- 激活邮件弹窗 -->
<div class="modal fade" id="noticeModal" tabindex="-1" role="dialog" aria-labelledby="noticeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="noticeModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form name="resend" action="" class="notice-email" showErrMsgHere="true">
                    <div class="main">
                        <div class="row message-wrap">
                            <div class="alert"></div>
                        </div>
                        <input type="hidden" name="email" value="">
                        <p class="content">邮件已经发送到您的邮箱：<br /><span class="email-text"></span></p>
                        <p>请您在24小时内登录邮箱完成验证</p>
                        <div class="notice">
                            <span>没收到邮件怎么办？</span>
                            <ol>
                                <li>请确保您的邮箱能正常收发邮件；</li>
                                <li>请确认邮件没有被系统拦截或被扔进了垃圾箱</li>
                                                                <li>再次<a href="javascript:void(0);" class="resend-handler">发送激活邮件</a></li>
                                                            </ol>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- 激活邮件弹窗 -->
<!-- 错误提示 -->
<div class="modal fade" tabindex="-1" role="dialog" id="errorMsg">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p></p>
            </div>
        </div>
    </div>
</div>
<!-- 错误提示 -->

<!-- 账号认领 -->
<input type="hidden" name="is_reclaimed" value="0">
<div class="modal fade message" id="accountClaimModal" data-backdrop="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">温馨提示</h4>
            </div>
            <div class="modal-body">
                <h4 class="text-center">账号已被认领</h4>
            </div>
            <div class="modal-footer text-center">
                <button class="btn team-account-logout" type="button">退出登录</button>
            </div>
        </div>
    </div>
</div>
<!-- 团队成员消息弹窗 -->
