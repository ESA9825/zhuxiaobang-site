// 基础信息查询
var queryApp = function () {
    $.ajax({
        type: 'POST',
        url: '/account/index/basic',
        data: {},
        success: function(res) {
            if (res.code === 0) {
                isTeamAccount = res.data.info.is_team_account
            } else {
                $errorMsg.find('.modal-body p').html(res.data.message);
                $errorMsg.modal('show');
                setTimeout(function() {
                    $errorMsg.modal('hide');
                }, 3000);
            }
        }
    });
}
queryApp()

// 开发者发布移动资源白名单(TT)
var appPublishWhiteList = function () {
    $.ajax({
        type: 'POST',
        url: '/oresource/officialapi/v1/permission/has-publish-permission',
        contentType: 'application/json',
        data: {},
        success: function(res) {
            if (res.code === 0) {
                hasPermission = !res.data.has_permission
            } else {
                $errorMsg.find('.modal-body p').html(res.data.message);
                $errorMsg.modal('show');
                setTimeout(function() {
                    $errorMsg.modal('hide');
                }, 3000);
            }
        }
    });
}
