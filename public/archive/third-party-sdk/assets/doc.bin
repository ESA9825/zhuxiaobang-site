<script>
(function (w, s, d, r, e, n) {
    (w[s] = w[s] || {
    readyListeners: [],
    onReady: function (e) {
        w[s].readyListeners.push(e);
    },
    }),
    ((e = d.createElement('script')).async = 1),
    (e.src = r),
    (n = d.getElementsByTagName('script')[0]).parentNode.insertBefore(e, n);
})(
    window,
    'cloudObservationRum',
    document,
    'https://ums-rum-cn.heytapimage.com/2.0.0/cloud-observation-rum.global.prod.js',
);

cloudObservationRum.onReady(function () {
    try {
    // 判断是内网还是外网。
    var collectionSourceUrl = window.location.origin.includes('.oppomobile.com') ? 'https://ums-telemetry-cn.heytapmobi.com' : 'https://ums-telemetry-test.wanyol.com'
    function getCookie(name){
        var val = ""
        var reg = new RegExp("(^| )" + name + "=([^;]*)(;|$)")
        var tokenInfo = document.cookie.match(reg) // 通过上式正则取到cookie中带 name变量 的字段
        if(tokenInfo){
            val = tokenInfo[2]
        }
        return val
    }
    var deploymentVersion;
    var openplatGray = getCookie('openplatGray');
    if (window.location.host === 'test.open.oppomobile.com') {
        deploymentVersion = 'test';
    } else if (openplatGray === '' || openplatGray == 0) {
        deploymentVersion = 'prod';
    } else {
        deploymentVersion = 'grey';
    }
    const config = {
        collectionSourceUrl: collectionSourceUrl, 
        serviceName:'common-frontend',
        deploymentVersion: deploymentVersion,
        ignoreUrls: []
    }
    cloudObservationRum.initialize(config)
    } catch(err) {
    console.log('初始化监控报错')
    }
})
</script>

    <script src="/static/scripts/wiki_doc.js?v=40c0a4ca2a"></script>
